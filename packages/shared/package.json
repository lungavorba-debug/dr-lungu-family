{

  "name": "@medscreen/shared",

  "version": "0.1.0",

  "private": true,

  "description": "Shared utilities, constants, and validation schemas",

  "main": "./dist/index.js",

  "types": "./dist/index.d.ts",

  "exports": {

    ".": {

      "types": "./dist/index.d.ts",

      "import": "./dist/index.js",

      "require": "./dist/index.js"

    }

  },

  "scripts": {

    "build": "rimraf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"

  },

  "dependencies": {

    "@medscreen/types": "*",

    "zod": "^3.24.1"

  },

  "devDependencies": {

    "rimraf": "^6.0.1",

    "typescript": "^5.7.3"

  }

}

