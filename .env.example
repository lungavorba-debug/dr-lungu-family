# ─── Shared / monorepo ────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) — local development ───────────────────
API_PORT=3001
API_HOST=0.0.0.0

# PostgreSQL (local Docker or Supabase)
# Local:
DATABASE_URL=postgresql://medscreen:medscreen@localhost:5432/medscreen?schema=public
# Supabase (pooler + direct — required when using Prisma with PgBouncer):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Required in production (Render API) ──────────────────
# Validated by @medscreen/config (Zod). NODE_ENV=production enforces all three.
# JWT_SECRET must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h

# Public frontend origin (Vercel) — required for CORS in production
CORS_ORIGIN=http://localhost:5173

# Public web app URL — required in production (password reset email links)
WEB_APP_URL=http://localhost:5173

# File storage for PDFs and clinic branding assets
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# ─── Deployment / CI (optional locally) ───────────────────
# Skip browser downloads during npm install/build on Render/Vercel:
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PUPPETEER_SKIP_DOWNLOAD=true
# SKIP_POSTINSTALL=1

# ─── Email delivery (Gmail SMTP) ──────────────────────────
# When SMTP_HOST is set, real email is sent. Ethereal is used ONLY when SMTP_HOST is missing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Dr. Lungu Family
SMTP_FROM_EMAIL=
EMAIL_ONLINE_REPORT_ENABLED=false

# ─── WhatsApp Cloud API (optional) ────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=

# ─── OpenAI voice assistant (optional) ────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ─── Web (apps/web) — Vercel ──────────────────────────────
# Dev: relative path uses Vite proxy to local API
VITE_API_BASE_URL=/api/v1
# Production (set in Vercel Dashboard, then redeploy):
# VITE_API_BASE_URL=https://medscreen-api.onrender.com/api/v1

# ─── Render production checklist ──────────────────────────
# DATABASE_URL, DIRECT_URL, JWT_SECRET (32+ chars), CORS_ORIGIN, WEB_APP_URL
#
# ─── Vercel production checklist ──────────────────────────
# VITE_API_BASE_URL=https://<your-render-api>.onrender.com/api/v1
