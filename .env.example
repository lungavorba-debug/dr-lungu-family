# ─── Shared ───────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ───────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# Required for authentication and database access
DATABASE_URL=postgresql://medscreen:medscreen@localhost:5432/medscreen?schema=public

# Required — minimum 32 characters (required in production)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h

# Must match the web app origin in production. In development, private LAN
# origins (e.g. http://192.168.x.x:5173) are allowed automatically.
CORS_ORIGIN=http://localhost:5173

# Must match the public web app URL for password reset links
WEB_APP_URL=http://localhost:5173

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# ─── Email delivery (Gmail SMTP) ──────────────────────────
# When SMTP_HOST is set, real email is sent. Ethereal is used ONLY when SMTP_HOST is missing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=drlungufamily@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=Dr. Lungu Family
SMTP_FROM_EMAIL=drlungufamily@gmail.com
# Legacy single-field sender (optional if SMTP_FROM_NAME + SMTP_FROM_EMAIL are set)
# SMTP_FROM=

# Online report button/URL in delivery emails (Patient Portal not yet live)
EMAIL_ONLINE_REPORT_ENABLED=false

# Optional: override recipient for E2E / verification scripts
# E2E_TEST_EMAIL_TO=

# ─── WhatsApp Cloud API ───────────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=

# ─── Web (apps/web) ───────────────────────────────────────
# Use a relative path so phones/tablets on the same Wi-Fi can reach the API
# through the Vite dev proxy at any LAN IP.
VITE_API_BASE_URL=/api/v1
