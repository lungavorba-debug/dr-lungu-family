# Server
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# ─── Database (required) ───────────────────────────────────
# Local Docker:
DATABASE_URL=postgresql://medscreen:medscreen@localhost:5433/medscreen?schema=public
# Supabase (Prisma + PgBouncer):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Auth (required in production) ───────────────────────
# Minimum 32 characters — enforced by Zod when NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h

# ─── URLs (required in production) ────────────────────────
# Must match the deployed Vercel frontend origin
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# ─── Storage ─────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# ─── Deployment flags (Render / CI) ──────────────────────
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PUPPETEER_SKIP_DOWNLOAD=true
# SKIP_POSTINSTALL=1

# ─── Gmail SMTP (optional — Ethereal fallback when SMTP_HOST unset) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Dr. Lungu Family
SMTP_FROM_EMAIL=
EMAIL_ONLINE_REPORT_ENABLED=false

# ─── WhatsApp Cloud API (optional) ───────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=

# ─── OpenAI (optional) ───────────────────────────────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
