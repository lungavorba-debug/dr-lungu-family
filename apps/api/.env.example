# Server
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# Required for database access
DATABASE_URL=postgresql://medscreen:medscreen@localhost:5432/medscreen?schema=public

# Required — minimum 32 characters (enforced in production)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h

# Must be a valid URL matching the web app origin
CORS_ORIGIN=http://localhost:5173

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# Public web app URL — required for password reset email links
WEB_APP_URL=http://localhost:5173

# ─── Gmail SMTP (production email) ────────────────────────
# Ethereal is used ONLY when SMTP_HOST is missing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=drlungufamily@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=Dr. Lungu Family
SMTP_FROM_EMAIL=drlungufamily@gmail.com
# Legacy single-field sender (optional if SMTP_FROM_NAME + SMTP_FROM_EMAIL are set)
# SMTP_FROM=

# Online report button/URL in delivery emails (Patient Portal not yet live)
EMAIL_ONLINE_REPORT_ENABLED=false

# Optional: test delivery recipient for verify-gmail-smtp.mjs / E2E
# E2E_TEST_EMAIL_TO=

# WhatsApp Cloud API — see docs/WHATSAPP_CLOUD_API_SETUP.md
#
# Phone number ID from Meta → WhatsApp → API Setup (NOT the WABA ID)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token recommended for production
WHATSAPP_ACCESS_TOKEN=
# Optional but useful for Meta Business administration
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Used for Meta webhook verification (auto-generated on first API start if empty)
WHATSAPP_VERIFY_TOKEN=
#
# ─── Finalizare verificare OTP/SMS (Meta Dashboard) ─────────────────────
# 1. developers.facebook.com → App → WhatsApp → API Setup
# 2. Add / select phone number → confirm OTP SMS/voice → status CONNECTED
# 3. Copy Phone number ID + Access Token into variables above
# 4. Development mode: API Setup → "To" test phone numbers → add recipient (+407xxxxxxxx)
# 5. npm run verify:whatsapp && npm run verify:whatsapp:health
#
# Eroare (#133010): OTP expeditor nefinalizat SAU destinatar absent din lista de test.
# Ghid complet: docs/WHATSAPP_CLOUD_API_SETUP.md

# OpenAI — enables AI voice assistant when set (no clinic DB config required)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
