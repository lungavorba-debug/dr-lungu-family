# ─── Local development ───────────────────────────────────
# Relative path — Vite dev server proxies /api to apps/api (port 3001)
VITE_API_BASE_URL=/api/v1

# ─── Vercel production ───────────────────────────────────
# Set in Vercel Dashboard → Environment Variables, then redeploy.
# VITE_API_BASE_URL=https://medscreen-api.onrender.com/api/v1
